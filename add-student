<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>➕ Add Student · लक्ष्य कोचिंग सेंटर</title>
    <style>
        *{ margin:0; padding:0; box-sizing:border-box; font-family:'Segoe UI',Roboto,sans-serif; }
        body{ background:linear-gradient(135deg, #e8f0f9 0%, #d4e2f0 100%); padding:24px 16px; display:flex; flex-direction:column; align-items:center; min-height:100vh; }
        
        .form-card{ background:white; max-width:1000px; width:100%; margin:20px auto; border-radius:48px; padding:36px 30px; box-shadow:0 25px 45px -12px #1a2a4a; }
        
        h2{ display:flex; align-items:center; gap:12px; color:#1a3a6e; margin-bottom:28px; font-size:1.9rem; border-left:5px solid #ff9800; padding-left:20px; }
        
        .coaching-badge{ background:linear-gradient(135deg,#1a3a6e,#2a5a9e); color:white; padding:8px 20px; border-radius:50px; font-size:0.85rem; margin-bottom:20px; display:inline-block; }
        
        .field{ margin-bottom:22px; }
        label{ font-weight:600; display:flex; align-items:center; gap:6px; margin-bottom:10px; color:#1a3a6e; font-size:1rem; }
        input, select{ width:100%; padding:14px 20px; font-size:1rem; background:#f8fafd; border:1.5px solid #c5d5e8; border-radius:60px; outline:none; transition: all 0.2s ease; }
        input:focus, select:focus{ border-color:#ff9800; background:white; box-shadow:0 0 0 3px rgba(255,152,0,0.1); }
        .row2{ display:flex; gap:15px; flex-wrap:wrap; }
        .row2 .field{ flex:1 1 200px; }
        
        .fees-section{ background:#f9fbfe; border-radius:32px; padding:20px 22px; margin:20px 0 12px 0; border:1px solid #dce6f2; }
        .section-title{ font-size:1.2rem; font-weight:800; color:#1a3a6e; margin-bottom:18px; display:flex; align-items:center; gap:8px; border-left:4px solid #ff9800; padding-left:14px; }
        
        .subjects-grid{ display:grid; grid-template-columns:repeat(auto-fill, minmax(220px,1fr)); gap:12px 20px; margin-bottom:25px; }
        .subject-item{ display:flex; align-items:center; gap:12px; background:white; padding:10px 18px; border-radius:50px; border:1px solid #d0e0f0; transition:0.15s; cursor:pointer; }
        .subject-item:hover{ background:#fff8ed; border-color:#ff9800; }
        .subject-item input{ width:20px; height:20px; margin:0; cursor:pointer; accent-color:#ff9800; }
        .subject-item label{ margin:0; font-weight:500; font-size:0.95rem; color:#1a3a6e; cursor:pointer; flex:1; }
        .subject-price{ font-weight:700; color:#0f5c3e; background:#e8f3ed; padding:4px 12px; border-radius:40px; font-size:0.8rem; }
        
        .extra-charges{ display:flex; flex-wrap:wrap; gap:12px; margin-top:8px; border-top:1px dashed #d0dcf0; padding-top:20px; margin-bottom:10px; }
        .extra-item{ background:#fffaf0; border-radius:40px; padding:8px 20px 8px 16px; display:flex; align-items:center; gap:10px; border:1px solid #ffe0b3; }
        .extra-item input{ width:18px; height:18px; margin:0; cursor:pointer; accent-color:#ff9800; }
        .extra-item label{ margin:0; font-weight:600; font-size:0.9rem; color:#a56700; cursor:pointer; }
        
        .discount-box{ background:#fff3e0; border-radius:50px; padding:14px 22px; margin:15px 0; border:1px solid #ffdead; }
        .discount-box label{ font-weight:700; color:#b45f06; margin-bottom:10px; display:block; }
        .discount-box input{ background:white; border-color:#ffdead; }
        
        .total-box{ background:#e6f0fa; border-radius:50px; padding:16px 24px; margin:20px 0 15px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; }
        .total-label{ font-weight:800; font-size:1.2rem; color:#1a3a6e; }
        .total-amount{ font-size:2rem; font-weight:800; color:#ff9800; background:white; padding:5px 25px; border-radius:60px; box-shadow:0 2px 8px rgba(0,0,0,0.05); }
        
        .payment-row{ display:flex; gap:20px; flex-wrap:wrap; margin:15px 0; }
        .payment-row .field{ flex:1; margin-bottom:0; }
        .due-highlight{ background:#fff5f0; color:#c0392b; font-weight:700; border-color:#ffccbb; }
        
        .btn-submit{ background:linear-gradient(135deg,#ff9800,#f57c00); border:none; color:white; font-size:1.2rem; font-weight:700; padding:16px 20px; width:100%; border-radius:60px; display:flex; align-items:center; justify-content:center; gap:12px; margin-top:25px; cursor:pointer; transition:0.2s; box-shadow:0 8px 18px rgba(245,124,0,0.3); }
        .btn-submit:hover{ background:linear-gradient(135deg,#f57c00,#e65100); transform:translateY(-2px); box-shadow:0 12px 24px rgba(245,124,0,0.4); }
        .btn-submit:disabled{ opacity:0.6; cursor:not-allowed; transform:none; }
        
        .info-note{ text-align:center; margin-top:20px; color:#2c577c; }
        a{ color:#ff9800; font-weight:600; text-decoration:none; border-bottom:1px dotted #ff9800; }
        .loading{ text-align:center; padding:14px; background:#eef2f8; border-radius:50px; margin-top:12px; font-weight:500; display:none; }
        .error-msg{ color:#c0392b; background:#fdecea; border-radius:40px; padding:10px 16px; margin-top:12px; text-align:center; display:none; border-left:4px solid #c0392b; }
        .success-toast{ position:fixed; bottom:25px; left:50%; transform:translateX(-50%); background:#2e7d32; color:white; padding:12px 28px; border-radius:60px; font-weight:600; z-index:1000; opacity:0; transition:opacity 0.2s; pointer-events:none; box-shadow:0 5px 15px rgba(0,0,0,0.2); }
        .class-warning{ background:#fff8e1; border-left:4px solid #ff9800; padding:12px 18px; border-radius:16px; margin-bottom:18px; font-size:0.85rem; color:#a56700; display:none; }
        
        .director-note{ background:linear-gradient(135deg,#fef9e6,#fffaf0); border-radius:20px; padding:12px 20px; margin-bottom:20px; text-align:center; border:1px solid #ffe0b3; color:#8B5A2B; font-size:0.85rem; }
        
        hr{ margin:10px 0; }
        @media (max-width:650px){ .form-card{ padding:24px 18px; } .subjects-grid{ grid-template-columns:1fr; } .total-amount{ font-size:1.5rem; padding:5px 15px; } }
    </style>
</head>
<body>
<div class="form-card">
    <div class="coaching-badge">🏆 लक्ष्य कोचिंग सेंटर 🏆</div>
    <h2>📋 नया छात्र पंजीकरण</h2>
    <div class="director-note">
        👨‍🏫 GUIDANCE BY: MR. MANISH SIR | 📞 +91 7654204716 | 📍 बंगरा पट्टी & जटौलिया चौक
    </div>
    
    <div class="field">
        <label>🔢 रोल नंबर (Roll Number)</label>
        <input type="text" id="rollNumber" placeholder="e.g. 2401" required>
    </div>
    <div class="field">
        <label>🧑 छात्र का नाम (Student Name)</label>
        <input type="text" id="studentName" placeholder="पूरा नाम लिखें" required>
    </div>
    <div class="field">
        <label>👨 पिता का नाम (Father Name)</label>
        <input type="text" id="fatherName" placeholder="पिता का नाम" required>
    </div>
    <div class="field">
        <label>📞 मोबाइल नंबर (Phone Number)</label>
        <input type="tel" id="phoneNumber" placeholder="e.g. 9876543210" pattern="[0-9]{10}">
    </div>
    <div class="row2">
        <div class="field">
            <label>📅 सत्र (Session)</label>
            <select id="sessionSelect">
                <option value="2024-25">2024-25</option>
                <option value="2025-26">2025-26</option>
                <option value="2026-27" selected>2026-27</option>
            </select>
        </div>
        <div class="field">
            <label>🏫 कक्षा (Class)</label>
            <select id="classSelect">
                <option value="Class 6">Class 6</option>
                <option value="Class 7">Class 7</option>
                <option value="Class 8">Class 8</option>
                <option value="Class 9">Class 9</option>
                <option value="Class 10">Class 10</option>
                <option value="Class 11">Class 11</option>
                <option value="Class 12">Class 12</option>
            </select>
        </div>
    </div>

    <div id="classWarning" class="class-warning">⚠️ कक्षा 11 एवं 12 के लिए फीस विषयों के चयन पर आधारित होगी।</div>
    <div id="dynamicFeeSection"></div>

    <button class="btn-submit" id="addStudentBtn">
        <i class="fas fa-save"></i> छात्र सहेजें (Save to Firebase)
    </button>
    <div class="info-note">↩ <a href="dashboard.html">Dashboard पर जाएं</a></div>
    <div id="loadingMessage" class="loading">⏳ Firebase में सेव हो रहा है...</div>
    <div id="errorMessage" class="error-msg"></div>
</div>
<div id="successToast" class="success-toast">✅ छात्र सफलतापूर्वक जोड़ा गया!</div>

<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<!-- Firebase SDK -->
<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore-compat.js"></script>

<script>
    // ==================== FIREBASE CONFIG (लक्ष्य कोचिंग सेंटर) ====================
    const firebaseConfig = {
        apiKey: "AIzaSyBoAqrgPwwM7GNyURqXrJEYWPihKKR8VGg",
        authDomain: "quest-coaching.firebaseapp.com",
        databaseURL: "https://quest-coaching-default-rtdb.asia-southeast1.firebasedatabase.app",
        projectId: "quest-coaching",
        storageBucket: "quest-coaching.firebasestorage.app",
        messagingSenderId: "131948734089",
        appId: "1:131948734089:web:f4ba25110c8b1298360858"
    };
    
    // Initialize Firebase
    firebase.initializeApp(firebaseConfig);
    const db = firebase.firestore();
    const feesCollection = db.collection('fees');
    const transactionsCollection = db.collection('transactions');

    // ==================== SUBJECTS & FEES (लक्ष्य कोचिंग सेंटर) ====================
    const SUBJECTS = [
        { name: "PHYSICS", price: 3000 },
        { name: "CHEMISTRY", price: 3000 },
        { name: "BIOLOGY", price: 3000 },
        { name: "MATHS", price: 3000 },
        { name: "HINDI", price: 3000 },
        { name: "ENGLISH", price: 3000 }
    ];
    
    const EXTRA_FEES = [
        { name: "ADMISSION FEE", price: 500 },
        { name: "EXAM FEE (Half Yearly + Annual)", price: 500 },
        { name: "ASSIGNMENT FEE", price: 500 }
    ];

    // Class-wise tuition fee (for Class 6 to 10)
    const getTuitionFee = (className) => {
        if (className === 'Class 10') return 7200;
        return 6000; // Class 6,7,8,9
    };

    // ==================== GLOBAL VARIABLES ====================
    let subjectCheckboxes = [];
    let extraCheckboxes = [];
    let advancedDiscountInput = null;
    let advancedReceivedInput = null;
    let advancedDueInput = null;
    let advancedTotalSpan = null;
    
    let checkboxTuition = null;
    let checkboxAdmission = null;
    let checkboxExam = null;
    let checkboxAssignment = null;
    let discountInputCheckbox = null;
    let receivedInputCheckbox = null;
    let dueInputCheckbox = null;
    let checkboxTotalSpan = null;
    
    let currentMode = 'simple'; // 'advanced' for Class 11/12, 'checkbox' for others
    let currentTuitionFee = 6000;
    
    const dynamicSection = document.getElementById('dynamicFeeSection');
    const classSelect = document.getElementById('classSelect');
    const classWarning = document.getElementById('classWarning');
    const addBtn = document.getElementById('addStudentBtn');
    const loadingMsg = document.getElementById('loadingMessage');
    const errorDiv = document.getElementById('errorMessage');
    const successToast = document.getElementById('successToast');
    
    // Form inputs
    const rollInput = document.getElementById('rollNumber');
    const nameInput = document.getElementById('studentName');
    const fatherInput = document.getElementById('fatherName');
    const phoneInput = document.getElementById('phoneNumber');
    const sessionSelect = document.getElementById('sessionSelect');

    // ==================== HELPER FUNCTIONS ====================
    function showToastMessage(message) {
        successToast.textContent = message;
        successToast.style.opacity = '1';
        setTimeout(() => { successToast.style.opacity = '0'; }, 2500);
    }

    function showErrorMessage(message) {
        errorDiv.textContent = message;
        errorDiv.style.display = 'block';
        setTimeout(() => { errorDiv.style.display = 'none'; }, 4000);
    }

    // Calculate total for advanced mode (Class 11/12)
    function calculateAdvancedTotal() {
        let total = 0;
        subjectCheckboxes.forEach(cb => {
            if (cb.checked) total += parseInt(cb.getAttribute('data-price')) || 0;
        });
        extraCheckboxes.forEach(cb => {
            if (cb.checked) total += parseInt(cb.getAttribute('data-price')) || 0;
        });
        let discount = advancedDiscountInput ? (parseFloat(advancedDiscountInput.value) || 0) : 0;
        return Math.max(0, total - discount);
    }
    
    // Calculate total for checkbox mode (Class 6-10)
    function calculateCheckboxTotal() {
        let total = 0;
        if (checkboxTuition && checkboxTuition.checked) total += currentTuitionFee;
        if (checkboxAdmission && checkboxAdmission.checked) total += 500;
        if (checkboxExam && checkboxExam.checked) total += 500;
        if (checkboxAssignment && checkboxAssignment.checked) total += 500;
        let discount = discountInputCheckbox ? (parseFloat(discountInputCheckbox.value) || 0) : 0;
        return Math.max(0, total - discount);
    }
    
    // Update due amounts
    function updateDue() {
        if (currentMode === 'advanced') {
            let total = calculateAdvancedTotal();
            if (advancedTotalSpan) advancedTotalSpan.innerText = total;
            let received = advancedReceivedInput ? (parseFloat(advancedReceivedInput.value) || 0) : 0;
            let due = Math.max(0, total - received);
            if (advancedDueInput) advancedDueInput.value = due;
        } else if (currentMode === 'checkbox') {
            let total = calculateCheckboxTotal();
            if (checkboxTotalSpan) checkboxTotalSpan.innerText = total;
            let received = receivedInputCheckbox ? (parseFloat(receivedInputCheckbox.value) || 0) : 0;
            let due = Math.max(0, total - received);
            if (dueInputCheckbox) dueInputCheckbox.value = due;
        }
    }
    
    // ==================== RENDER MODES ====================
    
    // Mode 1: Checkbox mode for Class 6-10
    function renderCheckboxMode(className) {
        currentMode = 'checkbox';
        currentTuitionFee = getTuitionFee(className);
        
        dynamicSection.innerHTML = `
            <div class="fees-section">
                <div class="section-title">💰 फीस घटक चुनें (Select Fees Components)</div>
                
                <div class="extra-item" style="margin-bottom:12px; background:#e8f0fe;">
                    <input type="checkbox" id="chk_tuition" checked>
                    <label for="chk_tuition">📚 ट्यूशन फीस (Tuition Fee)</label>
                    <span style="font-weight:700; margin-left:auto;">₹${currentTuitionFee}/-</span>
                </div>
                <div class="extra-item" style="margin-bottom:12px;">
                    <input type="checkbox" id="chk_admission" checked>
                    <label for="chk_admission">📋 एडमिशन फीस (Admission Fee)</label>
                    <span style="font-weight:700; margin-left:auto;">₹500/-</span>
                </div>
                <div class="extra-item" style="margin-bottom:12px;">
                    <input type="checkbox" id="chk_exam" checked>
                    <label for="chk_exam">📝 परीक्षा शुल्क (Exam Fee)</label>
                    <span style="font-weight:700; margin-left:auto;">₹500/-</span>
                </div>
                <div class="extra-item" style="margin-bottom:12px;">
                    <input type="checkbox" id="chk_assignment" checked>
                    <label for="chk_assignment">📖 असाइनमेंट शुल्क (Assignment Fee)</label>
                    <span style="font-weight:700; margin-left:auto;">₹500/-</span>
                </div>
                
                <div class="discount-box">
                    <label>🎁 छूट (Discount) ₹ में</label>
                    <input type="number" id="discountCheckbox" value="0" min="0" step="1" placeholder="जितना discount देना हो">
                </div>
                
                <div class="total-box">
                    <span class="total-label">💰 कुल फीस (Total Fees):</span>
                    <span class="total-amount" id="checkboxTotalAmount">0</span>
                </div>
                
                <div class="payment-row">
                    <div class="field">
                        <label>💵 प्राप्त राशि (Received Amount) ₹</label>
                        <input type="number" id="receivedCheckbox" value="0" min="0" step="1">
                    </div>
                    <div class="field">
                        <label>⏳ बकाया राशि (Due Amount)</label>
                        <input type="number" id="dueCheckbox" class="due-highlight" readonly value="0">
                    </div>
                </div>
            </div>
        `;
        
        // Get elements
        checkboxTuition = document.getElementById('chk_tuition');
        checkboxAdmission = document.getElementById('chk_admission');
        checkboxExam = document.getElementById('chk_exam');
        checkboxAssignment = document.getElementById('chk_assignment');
        discountInputCheckbox = document.getElementById('discountCheckbox');
        receivedInputCheckbox = document.getElementById('receivedCheckbox');
        dueInputCheckbox = document.getElementById('dueCheckbox');
        checkboxTotalSpan = document.getElementById('checkboxTotalAmount');
        
        // Add event listeners
        [checkboxTuition, checkboxAdmission, checkboxExam, checkboxAssignment].forEach(cb => {
            if (cb) cb.addEventListener('change', updateDue);
        });
        if (discountInputCheckbox) discountInputCheckbox.addEventListener('input', updateDue);
        if (receivedInputCheckbox) receivedInputCheckbox.addEventListener('input', updateDue);
        
        updateDue();
    }
    
    // Mode 2: Advanced subject selection for Class 11 & 12
    function renderAdvancedMode() {
        currentMode = 'advanced';
        
        dynamicSection.innerHTML = `
            <div class="fees-section">
                <div class="section-title">📖 विषय चुनें (Select Subjects) - ₹3000 प्रति विषय</div>
                <div class="subjects-grid" id="subjectsGrid"></div>
                
                <div class="section-title" style="margin-top:10px;">📌 अतिरिक्त शुल्क (Additional Charges)</div>
                <div class="extra-charges" id="extraChargesContainer"></div>
                
                <div class="discount-box">
                    <label>🎁 छूट (Discount) ₹ में</label>
                    <input type="number" id="advancedDiscount" value="0" min="0" step="1" placeholder="जितना discount देना हो">
                </div>
                
                <div class="total-box">
                    <span class="total-label">💰 कुल फीस (Total Fees):</span>
                    <span class="total-amount" id="advancedTotalAmount">0</span>
                </div>
                
                <div class="payment-row">
                    <div class="field">
                        <label>💵 प्राप्त राशि (Received Amount) ₹</label>
                        <input type="number" id="advancedReceived" value="0" min="0" step="1">
                    </div>
                    <div class="field">
                        <label>⏳ बकाया राशि (Due Amount)</label>
                        <input type="number" id="advancedDue" class="due-highlight" readonly value="0">
                    </div>
                </div>
            </div>
        `;
        
        // Populate subjects grid
        const subjectsGrid = document.getElementById('subjectsGrid');
        subjectCheckboxes = [];
        SUBJECTS.forEach(sub => {
            const div = document.createElement('div');
            div.className = 'subject-item';
            const cb = document.createElement('input');
            cb.type = 'checkbox';
            cb.id = `sub_${sub.name}`;
            cb.setAttribute('data-price', sub.price);
            cb.addEventListener('change', updateDue);
            const label = document.createElement('label');
            label.htmlFor = `sub_${sub.name}`;
            label.innerText = sub.name;
            const priceSpan = document.createElement('span');
            priceSpan.className = 'subject-price';
            priceSpan.innerText = `₹${sub.price}`;
            div.appendChild(cb);
            div.appendChild(label);
            div.appendChild(priceSpan);
            subjectsGrid.appendChild(div);
            subjectCheckboxes.push(cb);
        });
        
        // Populate extra fees
        const extraContainer = document.getElementById('extraChargesContainer');
        extraCheckboxes = [];
        EXTRA_FEES.forEach(extra => {
            const div = document.createElement('div');
            div.className = 'extra-item';
            const cb = document.createElement('input');
            cb.type = 'checkbox';
            cb.id = `extra_${extra.name.replace(/\s/g, '_')}`;
            cb.setAttribute('data-price', extra.price);
            cb.checked = true; // Default checked
            cb.addEventListener('change', updateDue);
            const label = document.createElement('label');
            label.htmlFor = cb.id;
            label.innerText = extra.name;
            const priceSpan = document.createElement('span');
            priceSpan.style.fontWeight = 'bold';
            priceSpan.style.marginLeft = 'auto';
            priceSpan.innerText = `₹${extra.price}`;
            div.appendChild(cb);
            div.appendChild(label);
            div.appendChild(priceSpan);
            extraContainer.appendChild(div);
            extraCheckboxes.push(cb);
        });
        
        advancedDiscountInput = document.getElementById('advancedDiscount');
        advancedReceivedInput = document.getElementById('advancedReceived');
        advancedDueInput = document.getElementById('advancedDue');
        advancedTotalSpan = document.getElementById('advancedTotalAmount');
        
        if (advancedDiscountInput) advancedDiscountInput.addEventListener('input', updateDue);
        if (advancedReceivedInput) advancedReceivedInput.addEventListener('input', updateDue);
        
        updateDue();
    }
    
    // ==================== GET CURRENT FEE DATA ====================
    function getSelectedSubjects() {
        if (currentMode !== 'advanced') return [];
        const selected = [];
        subjectCheckboxes.forEach((cb, idx) => {
            if (cb.checked) selected.push(SUBJECTS[idx].name);
        });
        return selected;
    }
    
    function getSelectedExtraFees() {
        if (currentMode !== 'advanced') return [];
        const selected = [];
        extraCheckboxes.forEach((cb, idx) => {
            if (cb.checked) selected.push(EXTRA_FEES[idx].name);
        });
        return selected;
    }
    
    function getTotalAmount() {
        if (currentMode === 'advanced') return calculateAdvancedTotal();
        else return calculateCheckboxTotal();
    }
    
    function getReceivedAmount() {
        if (currentMode === 'advanced') {
            return advancedReceivedInput ? (parseFloat(advancedReceivedInput.value) || 0) : 0;
        } else {
            return receivedInputCheckbox ? (parseFloat(receivedInputCheckbox.value) || 0) : 0;
        }
    }
    
    function getDiscountAmount() {
        if (currentMode === 'advanced') {
            return advancedDiscountInput ? (parseFloat(advancedDiscountInput.value) || 0) : 0;
        } else {
            return discountInputCheckbox ? (parseFloat(discountInputCheckbox.value) || 0) : 0;
        }
    }
    
    function getFeeBreakdown() {
        if (currentMode === 'advanced') {
            const subjectsTotal = getSelectedSubjects().length * 3000;
            const extraTotal = (extraCheckboxes[0]?.checked ? 500 : 0) + 
                              (extraCheckboxes[1]?.checked ? 500 : 0) + 
                              (extraCheckboxes[2]?.checked ? 500 : 0);
            return {
                type: 'subject_based',
                subjects: getSelectedSubjects(),
                subjects_total: subjectsTotal,
                admission_fee: extraCheckboxes[0]?.checked ? 500 : 0,
                exam_fee: extraCheckboxes[1]?.checked ? 500 : 0,
                assignment_fee: extraCheckboxes[2]?.checked ? 500 : 0,
                subtotal: subjectsTotal + extraTotal,
                discount: getDiscountAmount(),
                total: getTotalAmount()
            };
        } else {
            return {
                type: 'fixed_fees',
                tuition_fee: checkboxTuition?.checked ? currentTuitionFee : 0,
                admission_fee: checkboxAdmission?.checked ? 500 : 0,
                exam_fee: checkboxExam?.checked ? 500 : 0,
                assignment_fee: checkboxAssignment?.checked ? 500 : 0,
                discount: getDiscountAmount(),
                total: getTotalAmount()
            };
        }
    }
    
    function resetFormFields() {
        rollInput.value = '';
        nameInput.value = '';
        fatherInput.value = '';
        phoneInput.value = '';
        
        if (currentMode === 'advanced') {
            subjectCheckboxes.forEach(cb => cb.checked = false);
            extraCheckboxes.forEach(cb => cb.checked = true);
            if (advancedDiscountInput) advancedDiscountInput.value = '0';
            if (advancedReceivedInput) advancedReceivedInput.value = '0';
        } else {
            if (checkboxTuition) checkboxTuition.checked = true;
            if (checkboxAdmission) checkboxAdmission.checked = true;
            if (checkboxExam) checkboxExam.checked = true;
            if (checkboxAssignment) checkboxAssignment.checked = true;
            if (discountInputCheckbox) discountInputCheckbox.value = '0';
            if (receivedInputCheckbox) receivedInputCheckbox.value = '0';
        }
        updateDue();
        rollInput.focus();
    }
    
    // ==================== ON CLASS CHANGE ====================
    function onClassChange() {
        const selectedClass = classSelect.value;
        
        if (selectedClass === 'Class 11' || selectedClass === 'Class 12') {
            classWarning.style.display = 'block';
            renderAdvancedMode();
        } else {
            classWarning.style.display = 'none';
            renderCheckboxMode(selectedClass);
        }
    }
    
    // ==================== SAVE STUDENT TO FIREBASE ====================
    async function saveStudent() {
        errorDiv.style.display = 'none';
        
        const roll = rollInput.value.trim();
        const name = nameInput.value.trim();
        const father = fatherInput.value.trim();
        const phone = phoneInput.value.trim();
        const session = sessionSelect.value;
        const classVal = classSelect.value;
        
        if (!roll || !name || !father) {
            showErrorMessage('❌ कृपया रोल नंबर, छात्र का नाम और पिता का नाम भरें');
            return;
        }
        
        const totalAmount = getTotalAmount();
        const receivedAmount = getReceivedAmount();
        const dueAmount = Math.max(0, totalAmount - receivedAmount);
        
        // Prepare student data
        let studentData = {
            roll_number: roll,
            student_name: name,
            father_name: father,
            phone_number: phone || '',
            class: classVal,
            session: session,
            coaching_name: "लक्ष्य कोचिंग सेंटर",
            director: "MR. MANISH SIR",
            total_amount: totalAmount,
            received_amount: receivedAmount,
            due_amount: dueAmount,
            discount_applied: getDiscountAmount(),
            fee_breakdown: getFeeBreakdown(),
            created_at: firebase.firestore.FieldValue.serverTimestamp(),
            updated_at: firebase.firestore.FieldValue.serverTimestamp()
        };
        
        // Add subjects for Class 11/12
        if (currentMode === 'advanced') {
            studentData.subjects = getSelectedSubjects();
            studentData.extra_fees = getSelectedExtraFees();
        }
        
        loadingMsg.style.display = 'block';
        addBtn.disabled = true;
        
        try {
            // Check if roll number already exists in this session
            const existingQuery = await feesCollection
                .where('roll_number', '==', roll)
                .where('session', '==', session)
                .get();
            
            if (!existingQuery.empty) {
                showErrorMessage(`❌ रोल नंबर ${roll} इस सत्र में पहले से मौजूद है!`);
                loadingMsg.style.display = 'none';
                addBtn.disabled = false;
                return;
            }
            
            // Add student
            const docRef = await feesCollection.add(studentData);
            const studentId = docRef.id;
            
            // Save transaction if payment received
            if (receivedAmount > 0) {
                const transactionId = 'TXN' + Date.now() + Math.floor(Math.random() * 10000);
                const transactionData = {
                    studentId: studentId,
                    studentName: name,
                    rollNumber: roll,
                    studentClass: classVal,
                    session: session,
                    amount: receivedAmount,
                    previousReceived: 0,
                    newReceived: receivedAmount,
                    previousDue: totalAmount,
                    newDue: dueAmount,
                    transactionId: transactionId,
                    date: new Date().toISOString(),
                    payment_mode: "CASH",
                    created_at: firebase.firestore.FieldValue.serverTimestamp(),
                    note: `प्रारंभिक भुगतान - ₹${receivedAmount}`
                };
                await transactionsCollection.add(transactionData);
                console.log("Transaction saved:", transactionId);
            }
            
            showToastMessage(`✅ ${name} सफलतापूर्वक जोड़ा गया! (कुल: ₹${totalAmount}, जमा: ₹${receivedAmount})`);
            resetFormFields();
            
        } catch (error) {
            console.error("Firestore Error:", error);
            showErrorMessage(`❌ सेव नहीं हुआ: ${error.message}`);
        } finally {
            loadingMsg.style.display = 'none';
            addBtn.disabled = false;
        }
    }
    
    // ==================== EVENT LISTENERS ====================
    classSelect.addEventListener('change', onClassChange);
    addBtn.addEventListener('click', saveStudent);
    
    // Enter key support
    [rollInput, nameInput, fatherInput, phoneInput].forEach(input => {
        if (input) input.addEventListener('keypress', (e) => { if (e.key === 'Enter') saveStudent(); });
    });
    
    // Initialize
    onClassChange();
    
</script>
</body>
</html>
